{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestiune",
  "version": "0.0.0",
  "identifier": "ro.gestiune.app",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -w @gr/ui",
    "beforeBuildCommand": "npm run build -w @gr/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gestiune & Contabilitate",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:gestiune.db"]
    }
  }
}
