{
  "name": "gestiune-revamp",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicatie de gestiune + contabilitate, cross-platform (Windows/macOS/Linux), offline-first, modulara. Rescriere completa a proiectului KISS.",
  "packageManager": "npm@10.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["packages/*", "packages/modules/*", "apps/*", "server"],
  "scripts": {
    "dev": "turbo run dev --filter=@gr/ui",
    "dev:desktop": "npm run dev -w @gr/desktop",
    "dev:server": "npm run dev -w @gr/server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@gr/ui",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "tauri": "npm run tauri -w @gr/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
